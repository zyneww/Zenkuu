# Clé de permission « sending_access » (envoi seul) : une clé volée ne peut ni lire
# les domaines, ni en créer, ni révoquer quoi que ce soit.
# Créée le 11 août 2026 · id 673e66c0-36a8-4b95-96d2-db7862a217b6 · révocable par « resend api-keys remove 673e66c0-36a8-4b95-96d2-db7862a217b6 ».
RESEND_API_KEY=re_EEXpL65h_FJi84ccAT6zn6VTaYywX795P

# ⚠️ BAC À SABLE. « onboarding@resend.dev » n'envoie qu'à l'adresse du titulaire du
# compte Resend : suffisant pour valider la chaîne, INUTILISABLE dès le premier
# abonné. À remplacer par une adresse d'un domaine vérifié (resend domains create).
ALERT_FROM_EMAIL=onboarding@resend.dev

# Secret d'accès à /api/cron/alertes. La route refuse TOUT LE MONDE sans lui.
CRON_SECRET=1da73e66f97b89cbabc4229d9823bf35e82dcedb3af124a13a1147210d40ed73

